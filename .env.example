# Copy to .env and fill in locally. Never commit .env.
# The desk reads these from the environment. Empty means unset.

# Optional. The desk does not call Typesafe unless you add that later.
TYPESAFE_API_KEY=

# Bot token from BotFather. Telegram long-poll only.
TG_TOKEN=

# Unused on Plan B (Telegram is the only notifier). Leave blank.
VAPID_PRIVATE_KEY=

# Optional. Put it in the one-time fragment as #t=... so the phone can store it.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_TOKEN=

# Secret URL segment, 32+ characters. Generate locally. Never commit a real value.
# Generate: python -c "import secrets; print(secrets.token_hex(24))"
DATA_PATH=

# Helius (or other) Solana RPC HTTPS URL. Never commit a real URL.
RPC_URL=

# Plan B writer. Pages source is the /docs folder. Push stays off until the host opts in.
PAGES_DIR=docs
PAGES_PUSH=0
PAGES_PUSH_SEC=60
LOCAL_PREVIEW=0
DB_PATH=data/desk.sqlite
